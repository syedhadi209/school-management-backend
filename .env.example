SECRET_KEY=django-insecure-change-me
DEBUG=True
DJANGO_ENV=dev
ALLOWED_HOSTS=localhost,127.0.0.1

# Local Postgres (or set DATABASE_URL instead)
DB_NAME=school_management
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/school_management
# DB_SSL_REQUIRE=false

REDIS_URL=redis://localhost:6379/0

# Frontend origins (comma-separated). Required in production for CORS/CSRF.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional extra CORS regexes (comma-separated)
# CORS_ALLOWED_ORIGIN_REGEXES=

# Optional: Railway Bucket (private S3-compatible storage)
# When these are set, Django stores media in the bucket.
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
ENDPOINT=https://storage.railway.app
REGION=auto
S3_ADDRESSING_STYLE=virtual
S3_URL_EXPIRY_SECONDS=3600

# Production / Docker
# DJANGO_ENV=prod
# DJANGO_SETTINGS_MODULE=config.settings.prod
# SECURE_SSL_REDIRECT=true
# PORT=8080
